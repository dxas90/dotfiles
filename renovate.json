{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "rebaseWhen": "conflicted",
  "schedule": [
    "before 5:30am"
  ],
  "automerge": false,
  "automergeType": "pr",
  "pruneStaleBranches": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.chezmoidata\\.toml$/"
      ],
      "matchStrings": [
        "\\[tools\\.(?<depName>[a-zA-Z0-9_\\-]+)\\][\\s\\S]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "go"
      ],
      "overrideDatasource": "golang-version",
      "overridePackageName": "go"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "terraform"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "hashicorp/terraform",
      "extractVersion": "^v(?<version>.*)$",
      "versioning": "hashicorp"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "kubectl"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "kubernetes/kubernetes"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "flux"
      ],
      "overridePackageName": "fluxcd/flux2"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "linkerd2"
      ],
      "overridePackageName": "linkerd/linkerd2"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "helm"
      ],
      "overridePackageName": "helm/helm"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "rclone"
      ],
      "overridePackageName": "rclone/rclone"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "kopia"
      ],
      "overridePackageName": "kopia/kopia"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "cloudflared"
      ],
      "overridePackageName": "cloudflare/cloudflared"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "direnv"
      ],
      "overridePackageName": "direnv/direnv"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "go_task"
      ],
      "overridePackageName": "go-task/task"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "vagrant"
      ],
      "overridePackageName": "hashicorp/vagrant"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "age"
      ],
      "overridePackageName": "FiloSottile/age"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "bw"
      ],
      "overridePackageName": "bitwarden/clients"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "bws"
      ],
      "overridePackageName": "bitwarden/sdk"
    }
  ]
}
